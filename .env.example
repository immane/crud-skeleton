# Environment variable reference for local development.
# Symfony reads .env.local automatically. Docker Compose reads .env automatically,
# or any file passed with --env-file.
#
# For quick Docker development, no file is required: compose.yaml has safe dev defaults.
# For local native PHP, copy the variables you need into .env.local.
# For production Docker, copy .env.prod.example to .env.prod.local instead.

### Symfony
APP_ENV=dev
APP_SECRET=dev-secret-do-not-use-in-production

### Docker Compose
MYSQL_DATABASE=edc-online-membership
MYSQL_USER=app
MYSQL_PASSWORD=!ChangeMe!
MYSQL_ROOT_PASSWORD=!RootChangeMe!
MYSQL_VERSION=8.4
APP_PORT=8080
MAILPIT_UI_PORT=8025

### Database (native PHP — 127.0.0.1:3306, project DB)
# For local native PHP without Docker, set in .env.local (gitignored, never commit real password):
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/edc-online-membership?serverVersion=8.4&charset=utf8mb4"
# Docker Compose builds DATABASE_URL automatically from MYSQL_* above via compose.yaml.

### Identity / Auth (JWT + Refresh + OTP)
# Docker JWT keys are auto-generated by entrypoint.sh at container start.
# Native PHP users should set these to local PEM paths in .env.local.
JWT_PRIVATE_KEY_PATH=var/jwt_dev_private.pem
JWT_PUBLIC_KEY_PATH=var/jwt_dev_public.pem
JWT_PASSPHRASE=
# TTLs (seconds)
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=31536000
# Refresh token secret (change for production)
REFRESH_TOKEN_SECRET=dev-refresh-secret-do-not-use-in-production

# OTP / Redis
OTP_REDIS_DSN=redis://redis:6379/0

# Aliyun SMS (leave empty to disable)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_LOGIN_OTP=
ALIYUN_SMS_TEMPLATE_VERIFY_PHONE=
ALIYUN_SMS_DRY_RUN=true

### WeChat (optional — leave empty to disable)
# Mini Program
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_SECRET=
# Official Account
WECHAT_OFFICIAL_APP_ID=
WECHAT_OFFICIAL_SECRET=
WECHAT_OFFICIAL_TOKEN=
WECHAT_OFFICIAL_AES_KEY=
# WeChat Pay V3
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SECRET_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_CERTIFICATE=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_PUB_KEY_ID=
WECHAT_PAY_PUB_KEY_PATH=
